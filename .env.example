OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
SENTINEL_PRODUCT_NAME=SentinelGate
# Explicitly opt in only if you operate a documented HTTPS collection endpoint.
# SENTINEL_ONBOARDING_TELEMETRY_ENDPOINT=https://telemetry.example.com/v1/events
SENTINEL_DATABASE_PATH=./data/sentinelgate.db
# Production: postgresql://sentinelgate:password@postgres:5432/sentinelgate
# SENTINEL_DATABASE_URL=
SENTINEL_DATABASE_POOL_MIN_SIZE=1
SENTINEL_DATABASE_POOL_MAX_SIZE=10
SENTINEL_WORKER_POLL_INTERVAL_SECONDS=1
SENTINEL_WORKER_LEASE_SECONDS=30
SENTINEL_WORKER_MAX_ATTEMPTS=8
# SENTINEL_WORKER_ID=worker-1
SENTINEL_WATCH_ENABLED=true
# Watch Foundation defaults to deterministic monitor-only findings.
SENTINEL_WATCH_MONITOR_ONLY=true
# Watch+ LLM analysis is opt-in and never executes interventions.
SENTINEL_WATCH_INTELLIGENCE_ENABLED=false
# SENTINEL_OPENAI_API_KEY=
# SENTINEL_WATCH_INTELLIGENCE_MODEL=gpt-5.6-terra
SENTINEL_WATCH_INTELLIGENCE_ALLOW_DESCRIPTION=false
# Automatic response remains off unless explicitly enabled with a deterministic policy.
SENTINEL_WATCH_AUTO_RESPONSE_ENABLED=false
SENTINEL_POLICY_PATH=./config/policies.json
SENTINEL_KNOWLEDGE_PATH=./knowledge
SENTINEL_MCP_UPSTREAMS_PATH=./config/mcp_upstreams.json
SENTINEL_EVIDENCE_PATH=./evidence
SENTINEL_ENFORCEMENT_MODE=enforce
# SENTINEL_GITHUB_APP_ID=123456
# SENTINEL_GITHUB_INSTALLATION_ID=789012
# SENTINEL_GITHUB_PRIVATE_KEY_PATH=C:/secure/sentinelgate-app.private-key.pem
# SENTINEL_GITHUB_ALLOWED_REPOSITORIES=owner/repository
SENTINEL_AUDIT_SIGNING_KEY=replace-with-a-long-random-secret
SENTINEL_TOKEN_SIGNING_KEY=replace-with-a-different-long-random-secret
SENTINEL_DATA_ENCRYPTION_KEY=replace-with-a-third-long-random-secret
SENTINEL_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Production may mount managed secrets instead of placing values in environment variables:
# SENTINEL_AUDIT_SIGNING_KEY_FILE=/run/secrets/audit-signing-key
# SENTINEL_TOKEN_SIGNING_KEY_FILE=/run/secrets/token-signing-key
# SENTINEL_DATA_ENCRYPTION_KEY_FILE=/run/secrets/data-encryption-key
# SENTINEL_ADMIN_TOKEN_FILE=/run/secrets/admin-token
# Billing is disabled for self-hosted evaluation and grants local enterprise entitlements.
# Use test before live. Stripe Checkout and the customer portal hold payment data.
SENTINEL_BILLING_MODE=disabled
# Keep dedicated for local/self-hosted use. Shared mode enables the v0.16
# organisation boundary and requires OIDC-only auth plus billing.
SENTINEL_DEPLOYMENT_MODE=dedicated
SENTINEL_SELF_SERVICE_SIGNUP_ENABLED=false
SENTINEL_TERMS_VERSION=draft-2026-10
SENTINEL_PRIVACY_VERSION=draft-2026-10
SENTINEL_OPERATOR_SESSION_HOURS=8
SENTINEL_TENANT_DELETION_GRACE_DAYS=30
# SENTINEL_STRIPE_SECRET_KEY=sk_test_...
# SENTINEL_STRIPE_WEBHOOK_SECRET=whsec_...
# SENTINEL_STRIPE_SECRET_KEY_FILE=/run/secrets/stripe-secret-key
# SENTINEL_STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe-webhook-secret
# SENTINEL_STRIPE_PRICE_GATE=price_...
# SENTINEL_STRIPE_PRICE_WATCH=price_...
# SENTINEL_STRIPE_PRICE_WATCH_PLUS=price_...
# SENTINEL_STRIPE_PRICE_EXTRA_AGENT=price_...
# Production must use oidc or hybrid; shared is development-only.
SENTINEL_ADMIN_AUTH_MODE=shared
# SENTINEL_OIDC_ISSUER=https://your-tenant.example.com
# SENTINEL_OIDC_AUDIENCE=sentinelgate
# SENTINEL_OIDC_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# Optional browser authorization-code login. API bearer tokens still work without these.
# SENTINEL_OIDC_AUTHORIZATION_ENDPOINT=https://your-tenant.example.com/oauth2/v2.0/authorize
# SENTINEL_OIDC_TOKEN_ENDPOINT=https://your-tenant.example.com/oauth2/v2.0/token
# SENTINEL_OIDC_CLIENT_ID=sentinelgate-console
# SENTINEL_OIDC_CLIENT_SECRET=replace-with-provider-client-secret
# SENTINEL_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# SENTINEL_OIDC_SCOPES=openid profile email
# SENTINEL_OIDC_ROLE_CLAIM=roles
# SENTINEL_OIDC_ADMIN_ROLES=sentinelgate-admin,administrator
# SENTINEL_OIDC_APPROVER_ROLES=sentinelgate-approver
# SENTINEL_OIDC_ANALYST_ROLES=sentinelgate-analyst
# SENTINEL_OIDC_VIEWER_ROLES=sentinelgate-viewer
SENTINEL_DECLASSIFICATION_ALLOWED_LABELS=reviewed,false-positive
SENTINEL_APPROVAL_WEBHOOK_URL=
SENTINEL_APPROVAL_WEBHOOK_SECRET=tGQIFNFehGGhKPRldW7o6Qtqz2LRE45VB29PvGbzjrEgEUXqxt8W7GqsX_q9YrRr
# SENTINEL_APPROVAL_WEBHOOK_SECRET_FILE=/run/secrets/approval-webhook-secret
SENTINEL_CONSOLE_PUBLIC_URL=http://127.0.0.1:8000
SENTINEL_ENVIRONMENT=development
SENTINEL_ISSUER=https://sentinelgate.local
